# X (Twitter) API
X_BEARER_TOKEN=your_bearer_token_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pipeline settings (optional, have defaults)
CLAUDE_MODEL=claude-opus-4-5
MAX_TWEETS=100
OUTPUT_DIR=output
MAX_RETRIES=5

# ============================================================
# Arbitrage Bot Settings
# ============================================================

# Primary exchange: MEXC (APIキー不要でペーパートレード可能)
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_TAKER_FEE=0.001

# Optional: second exchange for cross-exchange arbitrage
# EXCHANGE2_ID=binance
# EXCHANGE2_API_KEY=
# EXCHANGE2_API_SECRET=
# EXCHANGE2_TAKER_FEE=0.001

# Trading pairs (comma-separated)
ARB_TRADING_PAIRS=BTC/USDT

# Triangular arbitrage
ARB_TRIANGULAR_BASE=USDT
ARB_TRIANGULAR_EXTRA_PAIRS=ETH/USDT,ETH/BTC,BNB/USDT,BNB/BTC

# Mode: true = paper trade only (no real orders)
ARB_PAPER_TRADING=true

# Opportunity thresholds
ARB_MIN_PROFIT_PCT=0.005
ARB_MIN_TRADE_USDT=10
ARB_MAX_TRADE_USDT=1000

# Risk controls
ARB_MAX_DAILY_LOSS_USDT=100
ARB_MAX_POSITION_USDT=5000
ARB_COOLDOWN_SECONDS=30

# Monitor
ARB_POLL_INTERVAL=1.0
ARB_OPP_TTL_SECONDS=5.0
ARB_SLIPPAGE_PCT=0.001

# Logging
ARB_LOG_TRADES=true
ARB_TRADE_LOG_PATH=logs/paper_trades.jsonl
